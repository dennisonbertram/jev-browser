# The classifier that picks one operation and one target element.
# Sign up at https://docs.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# The text model. It runs only when a task types into a field, so it should be
# small and fast. Any endpoint that speaks the OpenAI chat-completions protocol
# works. Pick one of these, or another provider.
#
#   OpenAI
#     TEXT_MODEL_BASE_URL=https://api.openai.com/v1
#     TEXT_MODEL=gpt-4.1-nano
#
#   Cerebras, which is the fastest of these. Both of its models reason
#   before answering, so ask for low effort or they spend the whole budget
#   thinking and return nothing.
#     TEXT_MODEL_BASE_URL=https://api.cerebras.ai/v1
#     TEXT_MODEL=gpt-oss-120b
#     TEXT_MODEL_REASONING_EFFORT=low
#
#   A gateway in front of several providers
#     TEXT_MODEL_BASE_URL=https://your-gateway/v1
#     TEXT_MODEL=openai/gpt-4.1-nano
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL=gpt-4.1-nano

# How long any model call may take before it is abandoned, in milliseconds.
# JEV_REQUEST_TIMEOUT_MS=60000

# Room for the text model to answer. Raise it for a model that reasons first.
# TEXT_MODEL_MAX_TOKENS=4000

# Sent only when set. "low" suits a field value on a reasoning model.
# TEXT_MODEL_REASONING_EFFORT=low
